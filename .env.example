# Required for Groq Whisper ASR and Qwen clinical analysis.
GROQ_API_KEY=your_groq_api_key_here

APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
ASR_MODEL=whisper-large-v3-turbo
LLM_MODEL=qwen/qwen3.8-27b
PROVIDER_TIMEOUT_SECONDS=30
MAX_AUDIO_BYTES=26214400
MAX_AUDIO_DURATION_SECONDS=600
MAX_TRANSCRIPT_CHARS=100000

# Audio preprocessing: 0-1, applied as prop_decrease = 1.0 - strength.
NOISE_REDUCTION_STRENGTH=0.5

# Silero VAD thresholds.
VAD_THRESHOLD=0.35
VAD_MIN_SPEECH_DURATION_MS=150
VAD_MIN_SILENCE_DURATION_MS=250
VAD_SPEECH_PAD_MS=180

# Speech segments shorter than this (seconds) are dropped before ASR.
VAD_MIN_SEGMENT_SECONDS=0.18

# Highest input sample rate accepted before resampling.
MAX_INPUT_SAMPLE_RATE=192000

# Maximum accepted length of the "language" form field.
MAX_LANGUAGE_CHARS=16

# Characters of rolling transcript context accepted per request.
ASR_CONTEXT_CHARS=1200

# Hard cap on the context sent as the Whisper prompt (provider allows ~224 tokens).
ASR_PROMPT_MAX_CHARS=800

